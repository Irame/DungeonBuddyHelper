<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Script file="PopupInsertedFrame.lua"/>

    <Frame name="DBH_PopupInsertedFrame" mixin="DBH_PopupInsertedFrameMixin" hidden="true">
        <Frames>
            <DropdownButton parentKey="KeySelectDropdown" inherits="WowStyle1DropdownTemplate">
                <Size x="200" y="25"></Size>
                <Anchors>
                    <Anchor point="TOP" y="-10"/>
                </Anchors>
            </DropdownButton>
            <Button parentKey="RefreshKeysButton" inherits="IconButtonTemplate">
                <KeyValues>
                    <KeyValue key="iconAtlas" value="talents-button-undo" type="string"/>
                    <KeyValue key="useAtlasSize" value="true" type="boolean"/>
                    <KeyValue key="useIconAsHighlight" value="true" type="boolean"/>
                    <KeyValue key="tooltipTextColor" value="HIGHLIGHT_FONT_COLOR" type="global"/>
                </KeyValues>
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.KeySelectDropdown" relativePoint="RIGHT" x="5"/>
                </Anchors>
            </Button>
            <DropdownButton parentKey="RunTypeDropdown" inherits="WowStyle1DropdownTemplate">
                <Size x="200" y="25"></Size>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.KeySelectDropdown" relativePoint="BOTTOMLEFT" y="-10"/>
                </Anchors>
            </DropdownButton>
            <Frame inherits="DBH_RoleSelectTemplate" parentKey="RoleSelect">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.RunTypeDropdown" relativePoint="BOTTOMRIGHT" x="0" y="-10"/>
                </Anchors>
            </Frame>
            <CheckButton parentKey="CustomGroupNameCheckBox">
                <Size x="15" y="15"/>
                <Anchors>
                    <Anchor point="TOP" relativeKey="$parent.RoleSelect" relativePoint="BOTTOM" x="0" y="-8" />
                    <Anchor point="LEFT" relativeKey="$parent.RunTypeDropdown" x="20" y="0" />
                </Anchors>
                <NormalTexture atlas="checkbox-minimal" useAtlasSize="true"/>
                <PushedTexture atlas="checkbox-minimal" useAtlasSize="true"/>
                <CheckedTexture atlas="checkmark-minimal" useAtlasSize="true"/>
            </CheckButton>
            <EditBox parentKey="CustomGroupNameInputBox" inherits="InputBoxTemplate" autoFocus="false">
                <Size y="20"/>
                <Anchors>
                    <Anchor point="TOP" relativeKey="$parent.CustomGroupNameCheckBox" relativePoint="BOTTOM" x="0" y="-5" />
                    <Anchor point="LEFT" relativeKey="$parent.RunTypeDropdown" x="0" y="0" />
                    <Anchor point="RIGHT" relativeKey="$parent.RunTypeDropdown" x="0" y="0" />
                </Anchors>
                <Scripts>
                    <OnEscapePressed>
                        self:ClearFocus()
                        self:GetParent():UpdateCommand()
                    </OnEscapePressed>
                    <OnEnterPressed>
                        self:ClearFocus()
                        self:GetParent():UpdateCommand()
                    </OnEnterPressed>
                </Scripts>
                <FontString inherits="ChatFontNormal"/>
            </EditBox>

            <EditBox parentKey="SingleLineInputBox" inherits="InputBoxTemplate" mixin="DBH_CommandInputBoxMixin" autoFocus="false">
                <Size y="20"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="5"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <Scripts>
                    <OnEscapePressed method="OnEscapePressed"/>
                    <OnMouseUp method="OnMouseUp"/>
                    <OnTextChanged method="OnTextChanged"/>
                </Scripts>
                <FontString inherits="ChatFontNormal"/>
            </EditBox>

			<Frame name="DBH_MultiLineInput" parentKey="MultiLineInput" inherits="TooltipBackdropTemplate">
				<Size y="100"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <Frames>
                    <ScrollFrame name="DBH_MultiLineInputScrollFrame" parentKey="ScrollFrame" inherits="ScrollFrameTemplate">
                        <KeyValues>
                            <KeyValue key="scrollBarHideIfUnscrollable" value="true" type="string"/>
                        </KeyValues>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="5" y="-5"/>
                            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-3" y="5"/>
                        </Anchors>
                        <ScrollChild>
                            <EditBox parentKey="Text" multiLine="true" mixin="DBH_CommandInputBoxMixin" autoFocus="false">
                                <Size x="280" y="1"/>
                                <Anchors>
                                    <Anchor point="TOPLEFT"/>
                                </Anchors>
                                <Scripts>
                                    <OnLoad function="ScrollingEdit_OnLoad"/>
                                    <OnCursorChanged function="ScrollingEdit_OnCursorChanged"/>
                                    <OnEscapePressed method="OnEscapePressed"/>
                                    <OnMouseUp method="OnMouseUp"/>
                                    <OnTextChanged method="OnTextChanged"/>
                                </Scripts>
                                <FontString inherits="ChatFontSmall"/>
                            </EditBox>
                        </ScrollChild>
                    </ScrollFrame>
                </Frames>
                <Scripts>
                    <OnLoad inherit="append">
                        self:GetParent().MultiLineInputBox = self.ScrollFrame.Text
                    </OnLoad>
                </Scripts>
			</Frame>
        </Frames>
        <Layers>
            <Layer>
                <FontString text="Missing Roles:" inherits="GameFontNormalSmall">
                    <Scripts>
                        <OnLoad function="MPLM_LocalizeFontString"/>
                    </Scripts>
                    <Anchors>
                        <Anchor point="RIGHT" relativeKey="$parent.RoleSelect" relativePoint="LEFT" x="-5" y="0"/>
                    </Anchors>
                </FontString>
                <FontString text="Custom group name" inherits="GameFontNormalSmall">
                    <Scripts>
                        <OnLoad function="MPLM_LocalizeFontString"/>
                    </Scripts>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.CustomGroupNameCheckBox" relativePoint="RIGHT" x="5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Size x="290"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEvent method="OnEvent"/>
        </Scripts>
    </Frame>
</Ui>